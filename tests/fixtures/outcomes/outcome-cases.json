{
  "schema": "outcome-cases/1",
  "note": "POST /outcomes cases over a real socket. The test builds the named scenario, then posts `body` (and, when present, `second` after it) and asserts the status, the code and the created flag of the last response. {project_id}, {palette_id}, {candidate_id}, {other_project_id}, {other_palette_id} and {mode} are replaced from the scenario and the contract; a literal id is used where the case needs an id that names no row. Every id here is synthetic.",
  "cases": [
    {
      "name": "an audition of the active candidate",
      "scenario": "selection",
      "body": {
        "client_event_id": "event-audition-1",
        "event_type": "auditioned",
        "project_id": "{project_id}",
        "palette_id": "{palette_id}",
        "candidate_id": "{candidate_id}",
        "run_id": "run-00000000000000000000000000000001",
        "palette_revision": 1,
        "ranking_version": "ranking-v1",
        "mode": "{mode}",
        "candidate_analysis_version": "analysis-v1"
      },
      "status": 201,
      "code": null,
      "created": true
    },
    {
      "name": "a selection of the active candidate",
      "scenario": "selection",
      "body": {
        "client_event_id": "event-selected-1",
        "event_type": "selected",
        "project_id": "{project_id}",
        "palette_id": "{palette_id}",
        "candidate_id": "{candidate_id}",
        "run_id": "run-00000000000000000000000000000001",
        "palette_revision": 1,
        "ranking_version": "ranking-v1",
        "mode": "{mode}",
        "candidate_analysis_version": "analysis-v1"
      },
      "status": 201,
      "code": null,
      "created": true
    },
    {
      "name": "the same content under the same client event id",
      "scenario": "selection",
      "body": {
        "client_event_id": "event-idempotent-1",
        "event_type": "auditioned",
        "project_id": "{project_id}",
        "palette_id": "{palette_id}",
        "candidate_id": "{candidate_id}",
        "run_id": "run-00000000000000000000000000000001",
        "palette_revision": 1,
        "ranking_version": "ranking-v1",
        "mode": "{mode}",
        "candidate_analysis_version": "analysis-v1"
      },
      "second": {
        "client_event_id": "event-idempotent-1",
        "event_type": "auditioned",
        "project_id": "{project_id}",
        "palette_id": "{palette_id}",
        "candidate_id": "{candidate_id}",
        "run_id": "run-00000000000000000000000000000001",
        "palette_revision": 1,
        "ranking_version": "ranking-v1",
        "mode": "{mode}",
        "candidate_analysis_version": "analysis-v1"
      },
      "status": 200,
      "code": null,
      "created": false
    },
    {
      "name": "a known client event id with different content",
      "scenario": "selection",
      "body": {
        "client_event_id": "event-conflict-1",
        "event_type": "auditioned",
        "project_id": "{project_id}",
        "palette_id": "{palette_id}",
        "candidate_id": "{candidate_id}",
        "run_id": "run-00000000000000000000000000000001",
        "palette_revision": 1,
        "ranking_version": "ranking-v1",
        "mode": "{mode}",
        "candidate_analysis_version": "analysis-v1"
      },
      "second": {
        "client_event_id": "event-conflict-1",
        "event_type": "auditioned",
        "project_id": "{project_id}",
        "palette_id": "{palette_id}",
        "candidate_id": "candidate-other-1",
