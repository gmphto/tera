              "decided_pairs": 3,
              "pairwise_accuracy": 1,
              "top1_margin": 1,
              "topk_mean": 2,
              "k": 3,
              "descriptive_k": true
            }
          }
        }
      ],
      "expected_arm": {
        "dsp-only": {
          "pairwise_accuracy": 0.6666666666666666,
          "pairwise_queries": 1,
          "top1_margin": 1,
          "top1_queries": 1,
          "topk_mean": 2,
          "topk_queries": 1
        },
        "hybrid": {
          "pairwise_accuracy": 1,
