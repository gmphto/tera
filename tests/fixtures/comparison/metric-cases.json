              "c3",
              "c2"
            ]
          },
          "expected_aggregates": {
            "c1": 3,
            "c2": 1,
            "c3": 2
          },
          "expected": {
            "dsp-only": {
              "rated_size": 3,
              "scored_in_rated": 3,
              "decided_pairs": 3,
              "pairwise_accuracy": 0.6666666666666666,
              "top1_margin": 1,
              "topk_mean": 2,
              "k": 3,
              "descriptive_k": true
