      "case": "import_request",
      "input": {
        "root": "C:\\Samples\\Kicks",
        "role": "kick"
      },
      "value": {
        "root": "C:\\Samples\\Kicks",
        "role": "kick"
      }
    },
    {
      "name": "every role is accepted",
      "case": "import_request",
      "input": {
        "root": "C:\\Samples\\Kicks",
        "role": "sub-bass"
      },
      "value": {
        "root": "C:\\Samples\\Kicks",
        "role": "sub-bass"
      }
    },
    {
      "name": "a body that is an array",
      "case": "import_request",
      "input": [],
      "code": "invalid_body"
    },
    {
      "name": "a body that is a string",
      "case": "import_request",
      "input": "Kicks",
      "code": "invalid_body"
    },
    {
      "name": "an empty body",
      "case": "import_request",
